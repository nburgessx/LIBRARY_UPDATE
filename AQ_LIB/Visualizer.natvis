<?xml version="1.0" encoding="utf-8"?> 
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

  <Type Name="AQLString">
    <DisplayString>[aqlString]{stringData_->string_,sb}</DisplayString>
    <Expand>
      <Item Name="[aqlString]">stringData_->string_,sb</Item>
    </Expand>
  </Type>
  
  <Type Name="AQLDate">
    <!-- dd-Mmm-yyyy, zero-padded day, one alternative per month (natvis has no printf-style padding,
         so day zero-padding is built as two concatenated {} blocks: a conditional "0" then the digits). -->
    <DisplayString Condition="mMonth==1">{(mDay&lt;10)?"0":""}{mDay}-Jan-{mYear}</DisplayString>
    <DisplayString Condition="mMonth==2">{(mDay&lt;10)?"0":""}{mDay}-Feb-{mYear}</DisplayString>
    <DisplayString Condition="mMonth==3">{(mDay&lt;10)?"0":""}{mDay}-Mar-{mYear}</DisplayString>
    <DisplayString Condition="mMonth==4">{(mDay&lt;10)?"0":""}{mDay}-Apr-{mYear}</DisplayString>
    <DisplayString Condition="mMonth==5">{(mDay&lt;10)?"0":""}{mDay}-May-{mYear}</DisplayString>
    <DisplayString Condition="mMonth==6">{(mDay&lt;10)?"0":""}{mDay}-Jun-{mYear}</DisplayString>
    <DisplayString Condition="mMonth==7">{(mDay&lt;10)?"0":""}{mDay}-Jul-{mYear}</DisplayString>
    <DisplayString Condition="mMonth==8">{(mDay&lt;10)?"0":""}{mDay}-Aug-{mYear}</DisplayString>
    <DisplayString Condition="mMonth==9">{(mDay&lt;10)?"0":""}{mDay}-Sep-{mYear}</DisplayString>
    <DisplayString Condition="mMonth==10">{(mDay&lt;10)?"0":""}{mDay}-Oct-{mYear}</DisplayString>
    <DisplayString Condition="mMonth==11">{(mDay&lt;10)?"0":""}{mDay}-Nov-{mYear}</DisplayString>
    <DisplayString Condition="mMonth==12">{(mDay&lt;10)?"0":""}{mDay}-Dec-{mYear}</DisplayString>
    <DisplayString>[aqlDate] {mDay}-{mMonth}-{mYear}</DisplayString> <!-- fallback: mMonth out of range -->
    <Expand>
      <Item Name="[yyyymmdd]">mYear*10000 + mMonth*100 + mDay</Item>
      <Item Name="[Day]">mDay</Item>
      <Item Name="[Month]">mMonth</Item>
      <Item Name="[Year]">mYear</Item>
      <Item Name="[Julius]" Optional="true">mJulius</Item>
	  <Item Name="[Excel]" Optional="true">(mJulius - 693594) &gt; 0 ? (mJulius - 693594) : 0</Item>
    </Expand>
  </Type>

  <Type Name="Variant">
    <DisplayString>[Variant]{value_}</DisplayString>
    <Expand>
      <Item Name="[Type]" Optional="true">type_</Item>
      <Item Name="[Value]">value_</Item>
    </Expand>
  </Type>
  
</AutoVisualizer>