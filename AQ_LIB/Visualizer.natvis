<?xml version="1.0" encoding="utf-8"?> 
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

  <Type Name="AQLString">
    <DisplayString>[aqlString]{stringData_->string_,sb}</DisplayString>
    <Expand>
      <Item Name="[aqlString]">stringData_->string_,sb</Item>
    </Expand>
  </Type>
  
  <Type Name="AQLDate">
    <!-- dd-Mmm-yyyy, zero-padded day. natvis's ternary operator does not reliably evaluate when its
         two branches are string literals (tried and confirmed broken even with matching array sizes),
         so padding is done with a literal "0" in the DisplayString text itself, selected via a second,
         mutually-exclusive Condition per month (day_&lt;10 vs day_&gt;=10) rather than computed. -->
	<DisplayString Condition="month_==1  &amp;&amp; day_&lt;10">0{day_}-Jan-{year_}</DisplayString>
	<DisplayString Condition="month_==1  &amp;&amp; day_&gt;=10">{day_}-Jan-{year_}</DisplayString>
    <DisplayString Condition="month_==2  &amp;&amp; day_&lt;10">0{day_}-Feb-{year_}</DisplayString>
    <DisplayString Condition="month_==2  &amp;&amp; day_&gt;=10">{day_}-Feb-{year_}</DisplayString>
    <DisplayString Condition="month_==3  &amp;&amp; day_&lt;10">0{day_}-Mar-{year_}</DisplayString>
    <DisplayString Condition="month_==3  &amp;&amp; day_&gt;=10">{day_}-Mar-{year_}</DisplayString>
    <DisplayString Condition="month_==4  &amp;&amp; day_&lt;10">0{day_}-Apr-{year_}</DisplayString>
    <DisplayString Condition="month_==4  &amp;&amp; day_&gt;=10">{day_}-Apr-{year_}</DisplayString>
    <DisplayString Condition="month_==5  &amp;&amp; day_&lt;10">0{day_}-May-{year_}</DisplayString>
    <DisplayString Condition="month_==5  &amp;&amp; day_&gt;=10">{day_}-May-{year_}</DisplayString>
    <DisplayString Condition="month_==6  &amp;&amp; day_&lt;10">0{day_}-Jun-{year_}</DisplayString>
    <DisplayString Condition="month_==6  &amp;&amp; day_&gt;=10">{day_}-Jun-{year_}</DisplayString>
    <DisplayString Condition="month_==7  &amp;&amp; day_&lt;10">0{day_}-Jul-{year_}</DisplayString>
    <DisplayString Condition="month_==7  &amp;&amp; day_&gt;=10">{day_}-Jul-{year_}</DisplayString>
    <DisplayString Condition="month_==8  &amp;&amp; day_&lt;10">0{day_}-Aug-{year_}</DisplayString>
    <DisplayString Condition="month_==8  &amp;&amp; day_&gt;=10">{day_}-Aug-{year_}</DisplayString>
    <DisplayString Condition="month_==9  &amp;&amp; day_&lt;10">0{day_}-Sep-{year_}</DisplayString>
    <DisplayString Condition="month_==9  &amp;&amp; day_&gt;=10">{day_}-Sep-{year_}</DisplayString>
    <DisplayString Condition="month_==10 &amp;&amp; day_&lt;10">0{day_}-Oct-{year_}</DisplayString>
    <DisplayString Condition="month_==10 &amp;&amp; day_&gt;=10">{day_}-Oct-{year_}</DisplayString>
    <DisplayString Condition="month_==11 &amp;&amp; day_&lt;10">0{day_}-Nov-{year_}</DisplayString>
    <DisplayString Condition="month_==11 &amp;&amp; day_&gt;=10">{day_}-Nov-{year_}</DisplayString>
    <DisplayString Condition="month_==12 &amp;&amp; day_&lt;10">0{day_}-Dec-{year_}</DisplayString>
    <DisplayString Condition="month_==12 &amp;&amp; day_&gt;=10">{day_}-Dec-{year_}</DisplayString>
    <DisplayString>[aqlDate] {day_}-{month_}-{year_}</DisplayString> <!-- fallback: month_ out of range -->
    <Expand>
      <Item Name="[yyyymmdd]">year_*10000 + month_*100 + day_</Item>
      <Item Name="[Day]">day_</Item>
      <Item Name="[Month]">month_</Item>
      <Item Name="[Year]">year_</Item>
      <Item Name="[Julius]" Optional="true">julius_</Item>
	  <Item Name="[Excel]" Optional="true">(julius_ - 693594) &gt; 0 ? (julius_ - 693594) : 0</Item>
    </Expand>
  </Type>

  <Type Name="Variant">
    <DisplayString>[Variant]{value_}</DisplayString>
    <Expand>
      <Item Name="[Type]" Optional="true">type_</Item>
      <Item Name="[Value]">value_</Item>
    </Expand>
  </Type>
  
</AutoVisualizer>